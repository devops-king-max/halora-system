# Local development only. Copy to .env and replace the password before startup.
# Changing these values does not rename an existing initialized database/user
# or rotate its password. Existing PostgreSQL volumes retain their credentials.
POSTGRES_DB=halora
POSTGRES_USER=halora_app
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5433

MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
