# Local development only. Copy to .env and replace the password before startup.
# Changing these values does not rename an existing initialized database/user
# or rotate its password. Existing PostgreSQL volumes retain their credentials.
POSTGRES_DB=halora
POSTGRES_USER=halora_app
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5433

MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Backend: generate two different random secrets (at least 32 characters).
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
QUOTE_SECRET=replace_with_another_random_secret_of_at_least_32_characters
PORT=3000
DB_HOST=127.0.0.1
SHIPPING_FEE=30000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
PUBLIC_BASE_URL=http://localhost:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=Halora <no-reply@halora.local>
STAFF_RESET_URL=http://localhost:5173/reset-password
CUSTOMER_RESET_URL=halora://reset-password

# AI product assistant (any OpenAI-compatible chat-completions provider; default opencode Go).
# Leave ASSISTANT_API_KEY empty to disable the feature;
# POST /me/assistant/chat then returns 503 ASSISTANT_UNAVAILABLE.
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=https://opencode.ai/inference/go/openai/v1
ASSISTANT_MODEL=deepseek-v4.1-flash

# Compose demo public URLs.
WEB_PORT=8080
WEB_BIND_HOST=127.0.0.1
DEMO_PUBLIC_BASE_URL=http://localhost:8080
DEMO_STAFF_RESET_URL=http://localhost:8080/reset-password
# Enable when serving behind HTTPS. Local HTTP demo uses false.
COOKIE_SECURE=false
# For a physical Android device, explicitly bind development API to LAN.
DEV_BIND_HOST=127.0.0.1
DEV_PUBLIC_BASE_URL=http://localhost:3000

# Fill with real administrator details before running db:bootstrap.
# Do not commit a real password. Remove the password after bootstrap.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_FULL_NAME=
# BOOTSTRAP_ADMIN_PHONE=
