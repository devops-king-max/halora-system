{
  "name": "@halora/api",
  "version": "1.0.0",
  "private": true,
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:bootstrap": "tsx scripts/bootstrap.ts",
    "db:bootstrap:docker": "tsx scripts/bootstrap-docker.ts",
    "db:export-schema": "tsx scripts/export-schema.ts",
    "db:verify-schema": "tsx scripts/verify-schema.ts",
    "db:backup:docker": "tsx scripts/backup-docker.ts",
    "db:restore-check:docker": "tsx scripts/restore-check-docker.ts",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand --testPathPattern=integration"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-pg-migrate": "^8.0.3",
    "nodemailer": "^7.0.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pdfkit": "^0.17.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "playwright": "1.58.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.ts"
    ],
    "testTimeout": 60000
  }
}
