{
  "compilerOptions": {
    "target": "ES2022", "module": "Node16", "moduleResolution": "Node16", "strict": true,
    "esModuleInterop": true, "experimentalDecorators": true, "emitDecoratorMetadata": true, "isolatedModules": true,
    "outDir": "dist", "rootDir": ".", "skipLibCheck": true, "sourceMap": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
